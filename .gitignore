ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or fail.
#__INIT__
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions of dependencies.
#   It is recommended to check this in:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact versions of dependencies
.pdm-plugins/
pdm.lock
pdm.toml

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath vars
*.sage.py

